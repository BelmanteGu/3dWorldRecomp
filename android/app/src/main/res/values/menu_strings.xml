    <string name="opt_quality">Perfil</string>
    <string name="opt_quality_sub">Um toque ajusta as linhas abaixo. Mudar uma delas mostra Personalizado.</string>
    <string name="opt_res">Resolução interna</string>
    <string name="opt_res_sub">Menor alivia a GPU. 1× é a do console (1280x720); 0,25× é para os aparelhos mais fracos.</string>
    <string name="opt_frameskip">Cair para 30 quando lento</string>
    <string name="opt_frameskip_sub">Vale em 60 e 120. Se o celular não aguentar 60 quadros por segundo o jogo ficaria em câmera lenta; no automático ele passa a desenhar um quadro a cada dois (como em 30) só enquanto precisar. Em 30 não muda nada.</string>
    <string name="fs_off">Desligado</string>
    <string name="fs_auto">Automático</string>
    <string name="fs_on">Sempre</string>
    <string name="opt_rate">Taxa de quadros</string>
    <string name="opt_rate_sub">30 mantém o jogo na velocidade normal (lógica a 60) e desenha um quadro a cada dois: para celulares fracos, menos calor e bateria. 120 mostra quadros intermediários (pede tela de 120 Hz e gasta mais CPU e bateria).</string>
    <string name="rate_30">30 (velocidade total)</string>
    <string name="opt_autores">Resolução automática</string>
    <string name="opt_autores_sub">Baixa a resolução interna quando a GPU não dá conta do ritmo escolhido; a resolução acima é o teto.</string>
    <string name="ar_off">Desligada</string>
    <string name="ar_30">Manter 30</string>
    <string name="ar_60">Manter 60</string>
    <string name="ar_120">Manter 120</string>
    <string name="opt_shadows">Sombras projetadas</string>
    <string name="opt_shadows_sub">O maior ganho em aparelho fraco: cerca de um terço dos desenhos numa fase.</string>
    <string name="opt_rt_mips">Detalhe dos efeitos borrados</string>
    <string name="opt_rt_mips_sub">Desligado economiza GPU; brilhos e desfoques ficam um pouco mais grossos.</string>
    <string name="opt_aniso">Texturas nítidas de longe</string>
    <string name="opt_aniso_sub">Filtragem anisotrópica 16×.</string>
